{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework":"vite",
  "buildCommand":"npm run build",
  "outputDirectory":"dist",
  "functions":{"api/ai.js":{"maxDuration":60},"api/engagement-cron.js":{"maxDuration":60}},
  "crons":[{"path":"/api/engagement-cron","schedule":"0 13 * * *"}],
  "redirects": [
    {"source":"/termos-de-uso","destination":"/termos-de-uso/","permanent":true},
    {"source":"/conheca","destination":"/","permanent":true},
    {"source":"/conheca/index.html","destination":"/","permanent":true},
    {"source":"/conheca/:path*","destination":"/site/:path*","permanent":true},
    {"source":"/site","destination":"/","permanent":true},
    {"source":"/site/","destination":"/","permanent":true},
    {"source":"/site/index.html","destination":"/","permanent":true},
    {"source":"/today","destination":"/home","permanent":true},
    {"source":"/decks","destination":"/areas","permanent":true},
    {"source":"/app","destination":"/home","permanent":true}
  ],
  "rewrites": [
    {"source":"/.well-known/oauth-protected-resource","destination":"/api/oauth-protected-resource"},
    {"source":"/api/chatgpt-import-image","destination":"/api/brains-mcp-prepare?operation=image"},
    {"source":"/","destination":"/index.html"},
    {"source":"/style-guide","destination":"/style-guide/index.html"},
    {"source":"/style-guide/","destination":"/style-guide/index.html"},
    {"source":"/:path*","destination":"/product.html"}
  ]
}
